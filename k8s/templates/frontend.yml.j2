apiVersion: apps/v1
kind: Deployment
metadata:
  name: frontend
  namespace: magic-mirror
  labels:
    app: frontend
  annotations:
    keel.sh/policy: force
    keel.sh/trigger: poll
    keel.sh/pollSchedule: "@every 5m"
spec:
  replicas: 1
  selector:
    matchLabels:
      app: frontend
  template:
    metadata:
      labels:
        app: frontend
    spec:
      imagePullSecrets:
        - name: ghcr-pull-secret
      containers:
        - name: frontend
          image: {{ registry_url }}/magic-mirror-frontend:{{ frontend_image_tag | default('latest') }}
          imagePullPolicy: Always
          ports:
            - containerPort: 3000
            - containerPort: 8443
          volumeMounts:
            - name: tls-certs
              mountPath: /opt/ssl
              readOnly: true
          livenessProbe:
            httpGet:
              path: /health
              port: 3000
            initialDelaySeconds: 10
            periodSeconds: 30
          readinessProbe:
            httpGet:
              path: /health
              port: 3000
            initialDelaySeconds: 5
            periodSeconds: 10
          resources:
            requests:
              memory: "64Mi"
              cpu: "50m"
            limits:
              memory: "128Mi"
              cpu: "250m"
      volumes:
        - name: tls-certs
{% if letsencrypt_enabled | default(false) %}
          secret:
            secretName: magic-mirror-letsencrypt-tls
            defaultMode: 0444
            items:
              - key: tls.crt
                path: tls.crt
              - key: tls.key
                path: tls.key
{% else %}
          secret:
            secretName: frontend-tls
            defaultMode: 0444
            items:
              - key: {{ server_fqdn }}.pem
                path: tls.crt
              - key: {{ server_fqdn }}.key
                path: tls.key
{% endif %}
---
apiVersion: v1
kind: Service
metadata:
  name: frontend
  namespace: magic-mirror
spec:
  type: NodePort
  selector:
    app: frontend
  ports:
    - name: http
      port: 3000
      targetPort: 3000
    - name: https
      port: 443
      targetPort: 8443
      nodePort: 30443
